SECRET_KEY=replace-with-a-unique-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=django.db.backends.postgresql
DB_NAME=your_database_name
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

# SMTP email settings (Gmail example; replace with your SMTP provider's values)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-gmail-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Fundora <your-email@gmail.com>

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

VISION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_MODEL=gemini-2.0-flash

SANDBOX_MODE=True
# Prototype Demo Mode (Set demo=True to enable interactive sandboxed video demo prototype)
demo=True
APPROVAL_TTL_SECONDS=300
MAX_AGENT_ITERATIONS=12

FX_API_URL=https://v6.exchangerate-api.com/v6/{key}/latest/USD
FX_API_KEY=your_api_key
